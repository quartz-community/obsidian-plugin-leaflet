{
  "name": "@quartz-community/obsidian-plugin-leaflet",
  "version": "1.0.1",
  "description": "Renders Obsidian Leaflet maps (```leaflet code blocks: image maps, real-world tile maps, markers) as interactive Leaflet maps in Quartz v5.",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/obsidian-plugin-leaflet"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "obsidian",
    "obsidian-leaflet",
    "leaflet",
    "maps",
    "remark"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prepublishOnly": "npm run build",
    "release": "npm run build && changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "peerDependencies": {
    "@jackyzha0/quartz": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@jackyzha0/quartz": {
      "optional": true
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "^1.5.0",
    "@quartz-community/utils": "^1.3.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@types/hast": "^3.0.4",
    "@types/leaflet": "^1.9.23",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.2",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  },
  "quartz": {
    "name": "obsidian-plugin-leaflet",
    "displayName": "Obsidian Leaflet",
    "category": [
      "transformer",
      "emitter"
    ],
    "version": "1.1.0",
    "quartzVersion": ">=5.1.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "blockLanguage": "leaflet",
      "tileServer": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "tileSubdomains": [],
      "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
      "defaultLat": 39.983334,
      "defaultLong": -82.98333,
      "markerColors": {}
    },
    "optionSchema": {
      "blockLanguage": {
        "type": "string",
        "default": "leaflet"
      },
      "tileServer": {
        "type": "string",
        "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      },
      "tileSubdomains": {
        "type": "array",
        "default": []
      },
      "attribution": {
        "type": "string"
      },
      "defaultLat": {
        "type": "number",
        "default": 39.983334
      },
      "defaultLong": {
        "type": "number",
        "default": -82.98333
      },
      "markerColors": {
        "type": "object",
        "default": {}
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
